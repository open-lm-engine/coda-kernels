    x: torch.Tensor,
    w: torch.Tensor,
    wn: torch.Tensor,
    wn2: torch.Tensor,
    cos: torch.Tensor,
    sin: torch.Tensor,
    head_dim: int,
    rope_layout: torch_ops.PairLayout,
    eps: float,
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    # nn.RMSNorm, per-head q and k norms, then rope with the cos and sin cache
    normed = torch.nn.functional.rms_norm(
        x,
        (x.shape[-1],),
        weight=wn,
        eps=eps,
    )
    qkv = torch.nn.functional.linear(
        input=normed,
        weight=w,
    )
    width = qkv.shape[-1] // 3
    # q and k are neighbouring columns of qkv, so qk is a view, not a copy
    qk, v = torch.split(qkv, (2 * width, width), dim=-1)
    rotated_qk = _qknorm_rope(
        qk=qk,
        gamma=wn2,
        cos=cos,
        sin=sin,
        rope_layout=rope_layout,
        head_dim=head_dim,
        eps=eps,
    )
    return x, rotated_qk, v


def transformer_block(
    x0: torch.Tensor,
    o0: torch.Tensor,
    v0: torch.Tensor,
    w0: torch.Tensor,
    w1: torch.Tensor,
    w2: torch.Tensor,
    w3: torch.Tensor,
    wn0: torch.Tensor,
    wn1: torch.Tensor,
    wn2: torch.Tensor,
    cos: torch.Tensor,
    sin: torch.Tensor,
    head_dim: int,
    rope_layout: torch_ops.PairLayout,
    swiglu_layout: torch_ops.PairLayout,
    eps: float,
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    # xsa_fwd, nn.RMSNorm, per-head q and k norms, then rope with the cos and sin cache
    xsa_out = torch_ops.xsa_fwd(
        x=o0,
        v=v0,
        head_dim=head_dim,
    )
    attention_out = torch.nn.functional.linear(
        input=xsa_out,
        weight=w0,
    )
    x1 = x0 + attention_out
    normed = torch.nn.functional.rms_norm(
        x1,
        (x1.shape[-1],),
        weight=wn0,
        eps=eps,
    )
    preact = torch.nn.functional.linear(
        input=normed,
        weight=w1,
    )
    postact = torch_ops.swiglu(
        preact=preact,
        layout=swiglu_layout,
    )
    mlp_out = torch.nn.functional.linear(
        input=postact,
        weight=w2,
    )
    x2 = x1 + mlp_out
    qkv_input = torch.nn.functional.rms_norm(
        x2,
        (x2.shape[-1],),
        weight=wn1,
        eps=eps,
    )
    qkv = torch.nn.functional.linear(
        input=qkv_input,
        weight=w3,
    )
    width = qkv.shape[-1] // 3
    # q and k are neighbouring columns of qkv, so qk is a view, not a copy
    qk, v = torch.split(qkv, (2 * width, width), dim=-1)
    rotated_qk = _qknorm_rope(
        qk=qk,
        gamma=wn2,
        cos=cos,
        sin=sin,
        rope_layout=rope_layout,
        head_dim=head_dim,
        eps=eps,
    )
    return x2, rotated_qk, v


